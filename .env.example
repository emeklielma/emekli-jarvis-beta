# Bu dosyayı ".env" adıyla kopyalayıp doldurun.
GEMINI_API_KEY=

# --- Telefon (Linphone, ÜCRETSİZ internet araması) ---
# Jarvis'in Linphone hesabı (subscribe.linphone.org'dan açılan ikinci hesap)
JARVIS_SIP_USER=
JARVIS_SIP_PASSWORD=
# Telefonundaki Linphone kullanıcı adın; Jarvis sadece bu hesabı arar ve sadece bu hesaptan gelen aramayı açar
JARVIS_SIP_OWNER=

# --- Telefon (Twilio, ücretli normal arama; Linphone kullanıyorsan boş bırak) ---
# twilio.com/console -> Account SID ve Auth Token
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio'dan aldığınız Jarvis numarası (ör. +1...)
TWILIO_PHONE_NUMBER=
# Jarvis'in arayabileceği ve Jarvis'i arayabilecek TEK numara (sizin numaranız)
JARVIS_OWNER_PHONE=+905XXXXXXXXX
# "ngrok http 8000" komutunun verdiği https adresi (sonunda / olmadan)
JARVIS_PUBLIC_URL=https://xxxx.ngrok-free.app
# İsteğe bağlı: aramada önce tuşlanacak PIN
JARVIS_PHONE_PIN=
# İsteğe bağlı: telefondan bilgisayar araçlarını kullanmaya izin ver (1). PIN şart.
JARVIS_PHONE_TOOLS=0
